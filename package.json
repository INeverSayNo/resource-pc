{
  "name": "vue-element-plus-admin",
  "version": "3.1.0",
  "description": "一套基于vue3、element-plus、typesScript、vite4的后台集成方案。",
  "author": "Archer <502431556@qq.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "i": "pnpm install",
    "dev": "vite --mode base",
    "build": "vite build --mode pro",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "preview": "vite preview --mode pro",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "clean": "rimraf dist dist-pro dist-dev dist-test node_modules/.cache",
    "npm:check": "pnpx npm-check-updates -u",
    "clean:cache": "rimraf node_modules/.cache",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "prettier --check --ignore-unknown .",
    "lint:format": "prettier --write --ignore-unknown --log-level warn .",
    "style:check": "stylelint \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:style": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged -c ./.husky/lintstagedrc.json",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/transformer-variant-group": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "esno": "^4.8.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unocss": "^66.7.5",
    "unplugin-element-plus": "0.10.0",
    "vite": "8.2.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.127.1"
  },
  "dependencies": {
    "@dczy/tie-monitor": "^1.0.1",
    "@dczy/tie-tools": "^1.0.1",
    "@iconify-icons/mdi": "^1.2.48",
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "echarts": "^6.1.0",
    "element-plus": "2.14.4",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "3.5.41",
    "vue-router": "^5.2.0"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=9.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kailong321200875/vue-element-plus-admin.git"
  },
  "bugs": {
    "url": "https://github.com/kailong321200875/vue-element-plus-admin/issues"
  },
  "homepage": "https://github.com/kailong321200875/vue-element-plus-admin",
  "volta": {
    "node": "22.16.0",
    "pnpm": "9.7.1"
  }
}
